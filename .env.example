# ---- Core ----
NODE_ENV=development
APP_URL=http://localhost:3000
PORTFOLIO_ROOT_DOMAIN=demos.yourdomain.com

# ---- Database (Supabase Postgres) ----
# Pooled connection for the app, direct connection for migrations.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/foundry?pgbouncer=true
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/foundry

# ---- Supabase (storage: logos, proposal PDFs) ----
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Auth (Clerk) ----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# ---- AI providers ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_MONTHLY_BUDGET_CENTS=50000

# ---- Email (Resend) ----
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# ---- Billing (Stripe) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICING_TABLE_ID=

# ---- Lead discovery providers ----
GOOGLE_PLACES_API_KEY=
APOLLO_API_KEY=

# ---- Queue / cache ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Automation ----
N8N_WEBHOOK_BASE_URL=
N8N_SHARED_SECRET=

# ---- Security ----
ENCRYPTION_KEY=        # 32-byte base64, for mailbox credential encryption
UNSUBSCRIBE_SIGNING_KEY=
CRON_SECRET=
