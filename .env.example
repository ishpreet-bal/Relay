# Required: core, database, Clerk, secrets. Everything else is an optional
# provider — leave it blank and its connector shows as "not configured".

# ---- Core ----
NODE_ENV=development
APP_URL=http://localhost:3000
# Optional: wildcard domain for legacy prospect demo sites.
PORTFOLIO_ROOT_DOMAIN=

# ---- Database (Supabase Postgres) ----
# Pooled connection for the app, direct connection for migrations. Connect as
# the table owner (or a BYPASSRLS role): RLS is on with no policies, which
# closes Supabase's REST API.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/relay?pgbouncer=true
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/relay

# ---- Supabase storage (optional; legacy proposal PDFs and logos) ----
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Auth (Clerk) ----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# ---- AI (research, drafting, verification) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_MONTHLY_BUDGET_CENTS=50000

# ---- Email sending (Resend) ----
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_COST_PER_EMAIL_MILLICENTS=0   # optional, for cost per meeting

# ---- Workspace billing (Stripe, optional) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICING_TABLE_ID=

# ---- Data providers ----
APOLLO_API_KEY=                      # company search (discovery), enrichment, contacts, email finding
APOLLO_COST_PER_CREDIT_MILLICENTS=0  # optional, for cost tracking (e.g. 2000 = 2 cents a credit)
APOLLO_SEARCH_CREDITS_PER_PAGE=1     # credits one organization-search page costs on your plan
GOOGLE_PLACES_API_KEY=               # discovery: Places API (New) Text Search; restrict the key to that API
GOOGLE_PLACES_COST_PER_REQUEST_MILLICENTS=3500  # list-price estimate per Text Search page (US$35/1,000)

# ---- Planned connectors (interfaces only; listed on the Connectors page) ----
# HUNTER_API_KEY=
# ZEROBOUNCE_API_KEY=
# ZEROBOUNCE_COST_PER_CHECK_MILLICENTS=800   # your plan's price per check; estimate used when unset
# HUNTER_COST_PER_CHECK_MILLICENTS=1000
# Customer billing charges live cards only when this is set (test keys work without it)
# CUSTOMER_BILLING_LIVE=enabled
# GOOGLE_CLIENT_ID= / GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID= / MICROSOFT_CLIENT_SECRET=
# TWILIO_ACCOUNT_SID= / TWILIO_AUTH_TOKEN=
# HUBSPOT_PRIVATE_APP_TOKEN=
# SALESFORCE_CLIENT_ID= / SALESFORCE_CLIENT_SECRET=

# ---- Queue / cache ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Automation ----
N8N_WEBHOOK_BASE_URL=
N8N_SHARED_SECRET=

# ---- Security ----
ENCRYPTION_KEY=        # 32-byte base64
UNSUBSCRIBE_SIGNING_KEY=
CRON_SECRET=
