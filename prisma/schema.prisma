// Relay — outbound sales operating system for B2B small businesses.
// Postgres 16 (Supabase).
//
// Tenancy has two levels:
//   Organization — the operating workspace (Relay itself, today). Hard
//                  boundary: every row carries organizationId.
//   Client       — a business Relay runs outbound for. Every prospect,
//                  campaign, call and meeting belongs to exactly one client,
//                  and client users can only ever see their own.
// Isolation is enforced in the service layer (src/server/access). Row-level
// security is enabled on every table with no policies, which closes the
// Supabase Data API to anon/authenticated roles; see docs/ASSESSMENT.md.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "fullTextSearchPostgres"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_DATABASE_URL")
  extensions = [pgcrypto, pg_trgm, vector]
}

// ---------------------------------------------------------------------------
// Tenancy, identity, permissions
// ---------------------------------------------------------------------------

model Organization {
  id            String  @id @default(uuid()) @db.Uuid
  clerkOrgId    String  @unique
  name          String
  slug          String  @unique
  // Sending identity + branding used by proposals and portfolio pages
  brandName     String?
  brandLogoUrl  String?
  brandPrimary  String  @default("#4F46E5")
  brandAccent   String  @default("#0EA5E9")
  sendingDomain String?
  websiteUrl    String?
  timezone      String  @default("America/Toronto")

  // Billing
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  plan                 Plan      @default(TRIAL)
  planSeats            Int       @default(1)
  trialEndsAt          DateTime?

  // Guardrails — volume is capped on purpose.
  dailySendCap           Int @default(60)
  hourlySendCap          Int @default(12)
  minMinutesBetweenSends Int @default(3)

  /**
   * Master switch for industry-only (CONTEXTUAL) drafts. The platform turns
   * it off on its own if the data says those sends aren't earning replies —
   * see services/tier-performance.ts.
   */
  allowContextual       Boolean   @default(true)
  contextualPausedAt    DateTime?
  contextualPauseReason String?

  /**
   * Rate card. Proposal pricing is arithmetic on these, never generated.
   */
  dayRateCents            Int     @default(120000)
  /// What an hour of delivery costs the agency (wages, overhead); for profitability, never shown to customers.
  internalHourlyCostCents Int     @default(6000)
  discoveryFeeCents       Int     @default(0)
  supportMonthlyCents     Int     @default(0)
  currency                String  @default("CAD")
  proposalTerms           String?
  proposalValidDays       Int     @default(30)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships       Membership[]
  clients           Client[]
  accounts          Account[]
  contacts          Contact[]
  campaigns         Campaign[]
  messages          Message[]
  templates         SolutionTemplate[]
  proposals         Proposal[]
  portfolios        PortfolioSite[]
  suppressions      Suppression[]
  mailboxes         Mailbox[]
  auditLogs         AuditLog[]
  apiKeys           ApiKey[]
  tasks             Task[]
  activities        Activity[]
  discoveryRuns     DiscoveryRun[]
  discoveryProfiles DiscoveryProfile[]
  callLeads         CallLead[]
  servicePackages   ServicePackage[]
  inquiries         Inquiry[]
  applications      ClientApplication[]
  duplicates        DuplicateCandidate[]
  savedViews        SavedView[]
  aiRuns            AiRun[]
  webhookEvents     WebhookEvent[]
  playbooks         Playbook[]
  offers            Offer[]
  icps              IdealCustomerProfile[]
  proofPoints       ProofPoint[]
  signals           Signal[]
  calls             Call[]
  callTasks         CallTask[]
  meetings          Meeting[]
  jobs              Job[]
  usageRecords      UsageRecord[]
  providerRecords   ProviderRecord[]
  provenance        DataProvenance[]
  connectorSettings ConnectorSetting[]
  messageClaims     MessageClaim[]
  opportunities     Opportunity[]
  subscriptions     CustomerSubscription[]

  @@index([deletedAt])
}

enum Plan {
  TRIAL
  SOLO
  AGENCY
  SCALE
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  clerkUserId String   @unique
  email       String   @unique
  firstName   String?
  lastName    String?
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships    Membership[]
  ownedAccounts  Account[]    @relation("AccountOwner")
  tasks          Task[]
  activities     Activity[]
  auditLogs      AuditLog[]
  calls          Call[]       @relation("Caller")
  callTasks      CallTask[]   @relation("CallTaskAssignee")
  meetingsBooked Meeting[]    @relation("MeetingBooker")
}

/**
 * Three parties use Relay. Internal staff (SUPER_ADMIN … CALLER) work across
 * every client in the workspace; client users (CLIENT_*) are bound to exactly
 * one client through Membership.clientId and never see internal operations.
 * Permissions per role live in src/lib/rbac.ts.
 */
enum Role {
  SUPER_ADMIN // billing, members, everything
  RELAY_ADMIN // runs operations across all clients
  OPERATOR // runs campaigns: approve, send, manage prospects
  ANALYST // research, enrichment and drafting; cannot send
  CALLER // call queue, call outcomes, meeting booking
  CLIENT_ADMIN // client portal plus their business profile, offers, ICPs
  CLIENT_MEMBER // client portal, read only
}

model Membership {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  userId         String   @db.Uuid
  role           Role     @default(CLIENT_MEMBER)
  /// Required for CLIENT_* roles; a client user without one has no access.
  clientId       String?  @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([clientId])
}

model ApiKey {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String
  // Only the SHA-256 hash is stored; the plaintext is shown once at creation.
  hashedKey      String    @unique
  prefix         String // first 8 chars, for display: "fdy_live_a1b2..."
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Clients and what they sell
// ---------------------------------------------------------------------------

enum ClientStatus {
  ONBOARDING
  ACTIVE
  PAUSED
  CHURNED
}

/**
 * A business Relay runs outbound for.
 */
model Client {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  slug           String
  status         ClientStatus @default(ONBOARDING)

  websiteUrl  String?
  domain      String?
  description String? @db.Text

  /// What they sell, in their words.
  productsServices  String[] @default([])
  /// Where they can deliver: "Ontario", "Ontario–Michigan lanes".
  serviceAreas      String[] @default([])
  industriesServed  String[] @default([])
  differentiators   String[] @default([])
  /// Names or domains of current customers. Never prospected, and only
  /// referenced in outreach through an approved ProofPoint.
  existingCustomers String[] @default([])

  averageDealValueCents Int?
  currency              String @default("CAD")
  timezone              String @default("America/Toronto")

  /// Who outreach is signed by and where meetings get booked.
  senderName     String?
  senderTitle    String?
  bookingUrl     String?
  /// The postal address printed in every email sent for this client. CASL
  /// requires a valid mailing address in each commercial message; nothing is
  /// sent without one.
  mailingAddress String?

  primaryContactName  String?
  primaryContactEmail String?
  primaryContactPhone String?
  /// Internal notes; never shown to the client.
  notes               String? @db.Text

  onboardedAt DateTime?
  archivedAt  DateTime?
  /// CUSTOMER, or DEMO for the workspace's synthetic demo sandbox (never prospected, never billed).
  kind        String    @default("CUSTOMER")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  organization      Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships       Membership[]
  offers            Offer[]
  icps              IdealCustomerProfile[]
  proofPoints       ProofPoint[]
  playbooks         Playbook[]
  accounts          Account[]
  contacts          Contact[]
  campaigns         Campaign[]
  messages          Message[]
  signals           Signal[]
  calls             Call[]
  callTasks         CallTask[]
  meetings          Meeting[]
  suppressions      Suppression[]
  usageRecords      UsageRecord[]
  research          Research[]
  activities        Activity[]
  discoveryProfiles DiscoveryProfile[]
  callLeads         CallLead[]
  inquiries         Inquiry[]
  applications      ClientApplication[]
  subscriptions     CustomerSubscription[]

  @@unique([organizationId, slug])
  @@index([organizationId, status])
}

/**
 * What the client is actually offering. Prospecting and messaging depend on it.
 */
model Offer {
  id                    String   @id @default(uuid()) @db.Uuid
  organizationId        String   @db.Uuid
  clientId              String   @db.Uuid
  name                  String
  /// One line: "Dedicated Ontario–Michigan transportation capacity".
  summary               String
  description           String?  @db.Text
  /// Why a buyer should care, in plain language.
  valueProposition      String?  @db.Text
  /// The smallest next step we ask for: "a 15-minute call".
  callToAction          String   @default("A 15-minute call")
  typicalDealValueCents Int?
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  campaigns    Campaign[]

  @@index([clientId, isActive])
}

enum Seniority {
  OWNER
  C_LEVEL
  VP
  DIRECTOR
  MANAGER
  SENIOR
  ENTRY
  UNKNOWN
}

/**
 * What a good customer looks like for one client. A client may have several.
 */
model IdealCustomerProfile {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  clientId       String  @db.Uuid
  name           String
  description    String? @db.Text

  // Company criteria
  industries         String[] @default([])
  industryKeywords   String[] @default([])
  excludedIndustries String[] @default([])
  employeeMin        Int?
  employeeMax        Int?
  /// Regions, provinces, states or countries: "Ontario", "ON", "Michigan".
  locations          String[] @default([])
  /// Plain-language requirements research checks for: "Ships physical goods".
  requiredAttributes String[] @default([])

  // Contact criteria
  targetTitles             String[]    @default([])
  targetDepartments        String[]    @default([])
  targetSeniorities        Seniority[] @default([])
  /// Below this headcount the owner is usually the buyer.
  smallCompanyMaxEmployees Int?
  smallCompanyTitles       String[]    @default([])

  // Signals that make an account timely
  preferredSignals SignalType[] @default([])
  signalKeywords   String[]     @default([])

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  accounts     Account[]
  campaigns    Campaign[]

  @@index([clientId, isActive])
}

enum ProofPointKind {
  CASE_STUDY
  TESTIMONIAL
  CUSTOMER
  RESULT
  CERTIFICATION
  CAPABILITY
  OTHER
}

/**
 * Statements the client can stand behind about itself. A draft may make a
 * claim about the sender only if it comes from an approved proof point —
 * the sender-side equivalent of a verified research citation.
 */
model ProofPoint {
  id                  String         @id @default(uuid()) @db.Uuid
  organizationId      String         @db.Uuid
  clientId            String         @db.Uuid
  kind                ProofPointKind @default(CAPABILITY)
  title               String
  /// Exactly how it may be said: "We run daily dedicated lanes Toronto–Detroit."
  statement           String         @db.Text
  customerName        String?
  industry            String?
  sourceUrl           String?
  evidenceNote        String?
  approvedForOutreach Boolean        @default(false)
  approvedAt          DateTime?
  approvedById        String?        @db.Uuid
  isActive            Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, isActive])
}

/**
 * How Relay approaches a kind of campaign. Workspace templates
 * (clientId = null) are copied onto clients and edited there. Nothing about
 * an industry is hard-coded in the application; it lives in these rows.
 */
model Playbook {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  clientId       String? @db.Uuid
  name           String
  slug           String
  description    String? @db.Text
  industryFocus  String?

  targetAccountTypes String[]     @default([])
  targetTitles       String[]     @default([])
  targetDepartments  String[]     @default([])
  usefulSignals      SignalType[] @default([])
  signalKeywords     String[]     @default([])
  /// Factual claim types a draft may make without human review.
  approvedClaimTypes ClaimType[]  @default([])

  /// [{ key, name, description }]
  messagingAngles       Json?
  /// [{ order, delayDays, purpose, instructions }]
  sequenceTemplate      Json?
  callOpener            String?  @db.Text
  discoveryQuestions    String[] @default([])
  /// [{ objection: ObjectionType, response }]
  objectionHandling     Json?
  qualificationCriteria String[] @default([])
  autoApproveThreshold  Float    @default(0.92)

  isTemplate       Boolean  @default(false)
  isActive         Boolean  @default(true)
  sourcePlaybookId String?  @db.Uuid
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  campaigns    Campaign[]

  @@unique([organizationId, slug])
  @@index([clientId])
}

// ---------------------------------------------------------------------------
// Accounts (companies) and contacts (people)
// ---------------------------------------------------------------------------

enum AccountStatus {
  DISCOVERED
  ENRICHED
  QUALIFIED
  ACTIVE_OUTREACH
  ENGAGED
  CALLING
  MEETING_BOOKED
  WON
  LOST
  DISQUALIFIED
}

enum EnrichmentStatus {
  NOT_STARTED
  PENDING
  ENRICHED
  PARTIAL
  FAILED
}

enum Temperature {
  COLD
  WARM
  HOT
}

enum DataSource {
  MANUAL
  CSV_IMPORT
  GOOGLE_PLACES
  OPENCORPORATES
  COMPANY_WEBSITE
  LINKEDIN
  APOLLO
  REFERRAL
  INBOUND
  OTHER
  PROVIDER
  RESEARCH
  CLIENT_PROVIDED
}

/**
 * A company one client may sell to.
 */
model Account {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  clientId       String @db.Uuid

  name            String
  /// Lower-cased name without legal suffixes or punctuation, for matching.
  /// See services/companies/normalize.ts.
  normalizedName  String?
  legalName       String?
  websiteUrl      String?
  domain          String? // normalized, used for dedupe within a client
  linkedinUrl     String?
  phone           String?
  industry        String?
  naicsCode       String?
  employeeCount   Int?
  employeeRange   String? // "11-50" when exact is unknown
  revenueRange    String?
  description     String?   @db.Text
  foundedYear     Int?
  businessModel   String?
  /// Public business profiles only: { instagram, facebook, x, youtube, tiktok }
  socialProfiles  Json?
  /// When a person or a first-party source last confirmed the record.
  lastVerifiedAt  DateTime?
  /// A branch or location of another account (the parent company).
  parentAccountId String?   @db.Uuid
  /// Set when this record was merged into another; the row is then archived.
  mergedIntoId    String?   @db.Uuid

  addressLine String?
  city        String?
  region      String? // province / state
  postalCode  String?
  country     String? @default("CA")
  latitude    Float?
  longitude   Float?
  timezone    String?

  techStack String[] @default([])
  keywords  String[] @default([])
  tags      String[] @default([])

  status           AccountStatus    @default(DISCOVERED)
  enrichmentStatus EnrichmentStatus @default(NOT_STARTED)
  enrichedAt       DateTime?
  researchSummary  String?          @db.Text
  /// The client ICP this account was scored against.
  icpId            String?          @db.Uuid

  /// Overall opportunity score, 0-100. See services/scoring/.
  score               Int         @default(0)
  /// Fit component (0-40), denormalized for sorting and analytics.
  fitScore            Int         @default(0)
  /// Engagement component (0-10).
  engagementScore     Int         @default(0)
  scoreBreakdown      Json?
  /// Null means the score is stale and the worker will recompute it.
  scoredAt            DateTime?
  scoreOverride       Int?
  scoreOverrideReason String?
  scoreOverriddenById String?     @db.Uuid
  scoreOverriddenAt   DateTime?
  temperature         Temperature @default(COLD)
  estimatedValueCents Int?
  notes               String?
  disqualifiedReason  String?

  source         DataSource @default(MANUAL)
  sourceRef      String? // provider-side id, for re-sync
  discoveryRunId String?    @db.Uuid
  ownerId        String?    @db.Uuid

  // Compliance
  doNotContact    Boolean   @default(false)
  suppressedAt    DateTime?
  suppressReason  String?
  lastContactedAt DateTime?
  lastEngagedAt   DateTime?
  nextFollowUpAt  DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  /// Why it was archived: USER, MERGED or RETENTION_EXPIRED (a source's
  /// storage limit passed before anyone confirmed or worked the account).
  archiveReason String?

  // Research funnel: cheap screening for everyone, AI analysis for the
  // promising, deep research for the best (services/pipeline).
  pipelineStage          PipelineStage    @default(DISCOVERED)
  opportunityTier        OpportunityTier?
  /// Deterministic 0–100 screening score; no model involved.
  screeningScore         Int?
  screeningReasons       Json?
  screenedAt             DateTime?
  /// A person set the stage; automatic screening leaves it alone.
  stagePinned            Boolean          @default(false)
  promotedById           String?          @db.Uuid
  promotedAt             DateTime?
  promotionNote          String?
  /// Last time any source saw this business (discovery, import, refresh).
  lastObservedAt         DateTime?
  /// Hash of the first-party identity last read from its website.
  contentFingerprint     String?
  fingerprintedAt        DateTime?
  /// Number of completed research versions.
  researchVersion        Int              @default(0)
  lastResearchedAt       DateTime?
  /// When this record is next due a freshness check.
  nextRefreshAt          DateTime?
  /// Total spent researching and enriching this account, in millicents.
  researchCostMillicents Int              @default(0)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  icp          IdealCustomerProfile? @relation(fields: [icpId], references: [id], onDelete: SetNull)
  owner        User?                 @relation("AccountOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  discoveryRun DiscoveryRun?         @relation(fields: [discoveryRunId], references: [id], onDelete: SetNull)
  parent       Account?              @relation("AccountBranches", fields: [parentAccountId], references: [id], onDelete: SetNull)
  branches     Account[]             @relation("AccountBranches")

  identifiers             DiscoveryIdentifier[]
  duplicateOf             DuplicateCandidate[]  @relation("DuplicateAccount")
  duplicates              DuplicateCandidate[]  @relation("DuplicateCandidate")
  contacts                Contact[]
  research                Research?
  activities              Activity[]
  tasks                   Task[]
  messages                Message[]
  enrollments             CampaignEnrollment[]
  proposals               Proposal[]
  portfolios              PortfolioSite[]
  meetings                Meeting[]
  signals                 Signal[]
  calls                   Call[]
  callTasks               CallTask[]
  provenance              DataProvenance[]
  automationOpportunities Opportunity[]

  @@unique([clientId, domain])
  // Trigram indexes for the explorer's substring search (ILIKE '%…%').
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Account_name_trgm_idx")
  @@index([domain(ops: raw("gin_trgm_ops"))], type: Gin, map: "Account_domain_trgm_idx")
  @@index([city(ops: raw("gin_trgm_ops"))], type: Gin, map: "Account_city_trgm_idx")
  @@index([clientId, pipelineStage, screeningScore(sort: Desc)])
  @@index([organizationId, pipelineStage])
  @@index([nextRefreshAt])
  @@index([clientId, normalizedName])
  @@index([parentAccountId])
  @@index([organizationId, clientId, status])
  @@index([clientId, score(sort: Desc)])
  @@index([organizationId, industry])
  @@index([organizationId, city])
  @@index([organizationId, nextFollowUpAt])
  @@index([scoredAt])
}

/// Research funnel stage. Records are never discarded for scoring low:
/// SCREENED_OUT accounts are kept and reconsidered when new signals arrive.
enum PipelineStage {
  DISCOVERED
  SCREENED_OUT
  QUALIFIED
  ANALYZED
  DEEP_RESEARCHED
}

enum OpportunityTier {
  HOT
  WARM
  EXPLORATORY
  LOW
  SUPPRESSED
}

enum EmailVerification {
  UNVERIFIED
  VALID
  RISKY
  INVALID
  CATCH_ALL
}

enum PhoneStatus {
  UNVERIFIED
  VALID
  INVALID
  WRONG_NUMBER
}

enum ContactStatus {
  ACTIVE
  BOUNCED
  LEFT_COMPANY
  WRONG_PERSON
}

/**
 * The legal basis on file for contacting someone. Recorded, never inferred —
 * Relay does not decide what the law allows.
 */
enum BuyingRole {
  DECISION_MAKER
  INFLUENCER
  CHAMPION
  GATEKEEPER
  END_USER
  UNKNOWN
}

enum ConsentBasis {
  UNKNOWN
  IMPLIED_PUBLISHED
  IMPLIED_RELATIONSHIP
  EXPRESS
}

/**
 * A person at an account.
 */
model Contact {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  clientId       String @db.Uuid
  accountId      String @db.Uuid

  firstName       String?
  lastName        String?
  title           String?
  department      String?
  seniority       Seniority  @default(UNKNOWN)
  isDecisionMaker Boolean    @default(false)
  /// Their part in a purchase decision, when known.
  buyingRole      BuyingRole @default(UNKNOWN)
  /// 0-1: how sure we are this is the right, current person and details.
  confidence      Float?
  lastVerifiedAt  DateTime?

  email             String?
  emailVerification EmailVerification @default(UNVERIFIED)
  emailVerifiedAt   DateTime?
  phone             String?
  phoneStatus       PhoneStatus       @default(UNVERIFIED)
  directPhone       String?
  mobilePhone       String?
  linkedinUrl       String?
  city              String?
  region            String?
  country           String?
  timezone          String?
  isPrimary         Boolean           @default(false)
  status            ContactStatus     @default(ACTIVE)

  // Where this came from — required for defensible outreach.
  source         DataSource @default(MANUAL)
  sourceProvider String?
  sourceRef      String?
  sourceUrl      String?
  sourcedAt      DateTime?

  score          Int   @default(0)
  scoreBreakdown Json?

  lastContactedAt DateTime?
  lastRepliedAt   DateTime?
  lastCalledAt    DateTime?
  callAttempts    Int       @default(0)

  // Compliance
  doNotEmail     Boolean      @default(false)
  doNotCall      Boolean      @default(false)
  unsubscribedAt DateTime?
  suppressedAt   DateTime?
  suppressReason String?
  consentBasis   ConsentBasis @default(UNKNOWN)
  consentNote    String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  account      Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  messages     Message[]
  enrollments  CampaignEnrollment[]
  calls        Call[]
  callTask     CallTask?
  meetings     Meeting[]
  activities   Activity[]
  provenance   DataProvenance[]

  @@unique([accountId, email])
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "Contact_email_trgm_idx")
  @@index([lastName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Contact_lastName_trgm_idx")
  @@index([organizationId, email])
  @@index([clientId, score(sort: Desc)])
}

/**
 * One execution of a discovery profile (or a one-off search): which sources
 * were asked, what came back, what was created, updated, skipped or flagged,
 * and what it cost.
 */
model DiscoveryRun {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  clientId       String?          @db.Uuid
  icpId          String?          @db.Uuid
  profileId      String?          @db.Uuid
  name           String
  /// Primary source for single-source runs; see `sources` for the rest.
  provider       DataSource?
  sources        String[]         @default([])
  trigger        DiscoveryTrigger @default(MANUAL)
  filters        Json // industry, geo, size, keywords, tech
  status         JobStatus        @default(QUEUED)
  queriesRun     Int              @default(0)
  requested      Int              @default(0)
  /// Results returned by sources.
  found          Int              @default(0)
  /// New accounts created.
  imported       Int              @default(0)
  /// Existing accounts that matched and were enriched.
  updated        Int              @default(0)
  /// Already known and nothing new to add.
  duplicates     Int              @default(0)
  /// Skipped by rule: existing customer, excluded keyword, suppressed.
  excluded       Int              @default(0)
  /// Possible duplicates awaiting a person's decision.
  needsReview    Int              @default(0)
  failedCount    Int              @default(0)
  costCents      Int              @default(0)
  costMillicents Int              @default(0)
  /// Per-source and per-query statistics.
  details        Json?
  error          String?
  createdById    String?          @db.Uuid
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime         @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profile      DiscoveryProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  accounts     Account[]
  results      DiscoveryResult[]

  @@index([organizationId, status])
  @@index([profileId, createdAt])
}

enum DiscoveryTrigger {
  MANUAL
  SCHEDULE
}

enum DiscoveryFrequency {
  MANUAL
  EVERY_6_HOURS
  DAILY
  WEEKLY
  MONTHLY
}

/**
 * A saved search that the scheduler runs on its own: where, what kind of
 * business, which sources, how often, and how much it may spend per month.
 */
model DiscoveryProfile {
  id                 String             @id @default(uuid()) @db.Uuid
  organizationId     String             @db.Uuid
  clientId           String             @db.Uuid
  icpId              String?            @db.Uuid
  name               String
  isActive           Boolean            @default(true)
  /// Connector ids to query, in order (e.g. google_places, apollo).
  sources            String[]           @default([])
  country            String             @default("CA")
  regions            String[]           @default([])
  cities             String[]           @default([])
  latitude           Float?
  longitude          Float?
  radiusKm           Int?
  /// Business categories to look for, e.g. "machine shop", "dental clinic".
  industries         String[]           @default([])
  keywords           String[]           @default([])
  /// Results whose name or category contains any of these are skipped.
  excludeKeywords    String[]           @default([])
  employeeMin        Int?
  employeeMax        Int?
  maxResultsPerRun   Int                @default(60)
  monthlyBudgetCents Int                @default(2000)
  frequency          DiscoveryFrequency @default(WEEKLY)
  /// Queue website research for new accounts (uses the AI budget).
  autoResearch       Boolean            @default(false)
  nextRunAt          DateTime?
  lastRunAt          DateTime?
  lastRunStatus      JobStatus?
  createdById        String?            @db.Uuid
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  archivedAt         DateTime?

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  runs         DiscoveryRun[]

  @@index([organizationId, isActive, nextRunAt])
}

/**
 * A business discovery found without a website of its own (none listed, only
 * a social or directory page, or a site that didn't load). Relay can't build
 * a record from it: Google's terms allow keeping only the place id. So it
 * waits on a call list, and its name, phone and address are read live from
 * Google when someone opens it, never stored. What is stored is Relay's own:
 * the search that found it and what happened on the phone. DO_NOT_CALL is
 * permanent, which makes this the internal do-not-call list as well.
 */
model CallLead {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  clientId       String    @db.Uuid
  profileId      String?   @db.Uuid
  runId          String?   @db.Uuid
  /// Where the id comes from, e.g. google_places.
  provider       String
  /// The provider's stable id (a Google place id): the only thing kept from the listing.
  externalId     String
  /// NO_WEBSITE, SOCIAL_ONLY or SITE_UNREACHABLE.
  reason         String
  /// The search that found it (our query, not the listing).
  searchTerm     String?
  searchCity     String?
  searchRegion   String?
  /// NEW, CALLBACK, CALLED, INTERESTED, NOT_INTERESTED, DO_NOT_CALL or CONVERTED.
  status         String    @default("NEW")
  notes          String?   @db.Text
  callbackAt     DateTime?
  calls          Int       @default(0)
  lastCalledAt   DateTime?
  lastCalledById String?   @db.Uuid
  /// The account created from what the business said on the call.
  accountId      String?   @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider, externalId])
  @@index([organizationId, clientId, status])
}

/**
 * An inquiry or consultation request sent from the public website. Stored
 * exactly as sent before anything else happens, so a visitor's message is
 * never lost even if linking it to an account fails. Responding to an
 * inquiry is implied consent under CASL for six months; marketing beyond
 * that needs the separate, recorded opt-in.
 */
model Inquiry {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @db.Uuid
  clientId         String   @db.Uuid
  name             String
  company          String
  email            String
  phone            String?
  website          String?
  industry         String?
  /// What the visitor picked: AUTOMATION, ACQUISITION, WEBSITES or NOT_SURE.
  service          String
  /// AUTOMATION, ACQUISITION, WEBSITE or GENERAL.
  category         String
  /// visitor (their choice), inferred (from the message) or staff (changed by a person).
  categorySource   String
  message          String   @db.Text
  /// Consultation times the visitor offered, as ISO instants.
  preferredTimes   Json?
  marketingConsent Boolean  @default(false)
  /// The exact opt-in wording shown, recorded with the consent.
  consentText      String?
  sourcePath       String?
  /// One-way hash of the sender's IP, used only for rate limiting.
  ipHash           String?
  /// NEW, CONTACTED, BOOKED, QUALIFIED, CLOSED or SPAM.
  status           String   @default("NEW")
  spamReason       String?
  accountId        String?  @db.Uuid
  contactId        String?  @db.Uuid
  taskId           String?  @db.Uuid
  meetingId        String?  @db.Uuid
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, createdAt])
  @@index([ipHash, createdAt])
  @@index([email, createdAt])
}

/**
 * Internal cost model for one service package: what it costs Relay to build
 * and run, and the price that cost implies at the target margin. Used for
 * quoting; never shown on the public website or to customers.
 */
model ServicePackage {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @db.Uuid
  /// AUTOMATION, ACQUISITION or WEBSITES.
  service           String
  name              String
  description       String?  @db.Text
  /// One-time: implementation hours, and third-party setup costs (licences, first-year fees).
  buildHours        Float    @default(0)
  setupCostCents    Int      @default(0)
  /// Monthly running costs.
  hostingCents      Int      @default(0)
  databaseCents     Int      @default(0)
  aiCents           Int      @default(0)
  thirdPartyCents   Int      @default(0)
  /// Domain, email and website upkeep, as a monthly amount.
  domainCents       Int      @default(0)
  monitoringCents   Int      @default(0)
  supportHours      Float    @default(0)
  maintenanceHours  Float    @default(0)
  targetMarginPct   Int      @default(40)
  /// What Relay quotes, when set, to compare against the cost.
  priceSetupCents   Int?
  priceMonthlyCents Int?
  /// The usage the contract includes, in words ("up to 2,000 documents a month").
  includedUsage     String?
  notes             String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId, service])
}

enum DiscoveryOutcome {
  CREATED
  UPDATED
  DUPLICATE
  EXCLUDED
  NEEDS_REVIEW
  FAILED
}

/**
 * What one source returned for one company in one run, and what Relay did
 * with it. The payload keeps only what is needed to explain the decision and
 * expires with the source's retention limit.
 */
model DiscoveryResult {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  runId          String           @db.Uuid
  provider       String
  externalId     String
  name           String
  domain         String?
  outcome        DiscoveryOutcome
  matchScore     Float?
  reason         String?
  accountId      String?          @db.Uuid
  payload        Json?
  expiresAt      DateTime?
  createdAt      DateTime         @default(now())

  run DiscoveryRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, provider, externalId])
  @@index([accountId])
  @@index([expiresAt])
}

/**
 * A stable id for an account at an outside source (a Google place id, an
 * Apollo organization id, a registry number). The strongest dedupe key there
 * is: the same id from the same source is the same company.
 */
model DiscoveryIdentifier {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  clientId       String   @db.Uuid
  accountId      String   @db.Uuid
  provider       String
  externalId     String
  createdAt      DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([clientId, provider, externalId])
  @@index([accountId])
}

enum DuplicateStatus {
  OPEN
  MERGED
  DISMISSED
}

/**
 * Two accounts that might be the same company, waiting for a person: the
 * evidence is not strong enough to merge automatically.
 */
model DuplicateCandidate {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  clientId       String          @db.Uuid
  /// The newer record.
  accountId      String          @db.Uuid
  /// The existing record it may duplicate.
  candidateId    String          @db.Uuid
  score          Float
  reasons        Json
  source         String?
  status         DuplicateStatus @default(OPEN)
  resolvedById   String?         @db.Uuid
  resolvedAt     DateTime?
  createdAt      DateTime        @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account      Account      @relation("DuplicateAccount", fields: [accountId], references: [id], onDelete: Cascade)
  candidate    Account      @relation("DuplicateCandidate", fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([accountId, candidateId])
  @@index([organizationId, clientId, status])
}

/**
 * A named set of list filters, private to a user or shared with the workspace.
 */
model SavedView {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  /// Null means shared with everyone in the workspace.
  userId         String?  @db.Uuid
  scope          String // "accounts" | "contacts"
  name           String
  filters        Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, scope])
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  RETRYING
}

// ---------------------------------------------------------------------------
// Signals, research and evidence
// ---------------------------------------------------------------------------

enum SignalType {
  HIRING
  FUNDING
  EXPANSION
  NEW_LOCATION
  NEW_CONTRACT
  NEW_PRODUCT
  TECHNOLOGY_CHANGE
  LEADERSHIP_CHANGE
  REGULATORY_EVENT
  CUSTOM_SIGNAL
}

/**
 * How far a piece of evidence has been checked.
 */
enum EvidenceStatus {
  VERIFIED // quote located on the source page, or independently confirmed
  PROVIDER_REPORTED // returned by a data provider, not independently checked
  UNVERIFIED // entered by hand or imported
  REJECTED // disproven: quote not found, email bounced, wrong number
}

/**
 * Something about an account that may make outreach relevant now.
 */
model Signal {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  clientId       String @db.Uuid
  accountId      String @db.Uuid

  type        SignalType
  title       String
  summary     String?    @db.Text
  sourceUrl   String?
  sourceQuote String?    @db.Text
  sourceTitle String?

  source           DataSource     @default(RESEARCH)
  provider         String?
  providerRecordId String?        @db.Uuid
  detectedAt       DateTime       @default(now())
  /// When the event itself happened, if the source says.
  eventDate        DateTime?
  confidence       Float          @default(0.5)
  evidenceStatus   EvidenceStatus @default(UNVERIFIED)
  metadata         Json?

  dismissedAt   DateTime?
  dismissedById String?   @db.Uuid
  dismissReason String?
  createdById   String?   @db.Uuid
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  account      Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  claims       MessageClaim[]

  @@index([accountId, detectedAt(sort: Desc)])
  @@index([clientId, type, detectedAt])
}

model Research {
  id             String  @id @default(uuid()) @db.Uuid
  accountId      String  @unique @db.Uuid
  organizationId String  @db.Uuid
  clientId       String  @db.Uuid
  /// The offer the research was framed around.
  offerId        String? @db.Uuid

  status JobStatus @default(QUEUED)

  // Raw evidence — every generated claim must trace back to one of these.
  pagesCrawled Json? // [{id, url, title, fetchedAt, chars}]
  rawExtract   String? @db.Text

  companySummary   String?  @db.Text
  servicesOffered  String[] @default([])
  detectedSoftware String[] @default([])
  observedSignals  Json? // {careersPage:true, ...}

  /// Verified facts with claim types: [{id, claimType, statement, citations[]}]
  facts     Json?
  /// Why this account might care about the client's offer, grounded.
  relevance Json?

  // Legacy (automation-agency research); read by proposals.
  painPoints    Json?
  opportunities Json?
  talkingPoints String[] @default([])
  citations     Json?

  estimatedHoursSavedPerMonth Int?
  estimatedAnnualSavingsCents Int?
  roiAssumptions              Json?
  confidence                  Float? // 0-1

  model         String?
  promptVersion String?
  tokensIn      Int?
  tokensOut     Int?
  costCents     Int?
  error         String?

  refreshedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
}

// ---------------------------------------------------------------------------
// Industry solution library (legacy agency tooling)
// ---------------------------------------------------------------------------

model SolutionTemplate {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String? @db.Uuid // null = built-in, shipped with the platform
  slug           String
  industry       String
  title          String
  tagline        String
  description    String  @db.Text
  heroImageUrl   String?
  accentColor    String  @default("#4F46E5")

  // The demo itself is data-driven so one renderer serves every industry.
  spec            Json // {kpis[], charts[], workflows[], portals[], modules[]}
  sampleData      Json // deterministic seed data powering the charts
  workflowDiagram Json? // nodes/edges for the automation diagram renderer

  isPublished Boolean  @default(false)
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  portfolios   PortfolioSite[]

  @@unique([organizationId, slug])
  @@index([industry])
}

// ---------------------------------------------------------------------------
// Campaigns, messages, verification
// ---------------------------------------------------------------------------

model Mailbox {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  provider       MailProvider @default(RESEND)
  fromName       String
  fromEmail      String
  replyToEmail   String?
  // Domain auth status, refreshed from provider
  spfVerified    Boolean      @default(false)
  dkimVerified   Boolean      @default(false)
  dmarcVerified  Boolean      @default(false)
  dailyCap       Int          @default(50)
  warmupStage    Int          @default(0)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())

  /// Gmail: the OAuth refresh token (AES-256-GCM), never returned to a browser.
  oauthRefreshTokenEnc String?
  /// The Google account that granted access; must be the mailbox's own address.
  oauthEmail           String?
  oauthScopes          String[]  @default([])
  oauthConnectedAt     DateTime?
  oauthError           String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages     Message[]
  campaigns    Campaign[]

  @@unique([organizationId, fromEmail])
}

enum MailProvider {
  RESEND
  GMAIL
  OUTLOOK
  SMTP
}

enum CampaignStatus {
  DRAFT
  READY_FOR_REVIEW
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

/**
 * REVIEW_ALL            — every draft waits for a human.
 * AUTO_APPROVE_VERIFIED — drafts whose verification clears the campaign
 * threshold, and whose factual claims are all of
 * approved types, are approved by policy; the rest
 * go to review. The send gate runs either way.
 */
enum ApprovalMode {
  REVIEW_ALL
  AUTO_APPROVE_VERIFIED
}

model Campaign {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  clientId       String         @db.Uuid
  icpId          String?        @db.Uuid
  offerId        String?        @db.Uuid
  playbookId     String?        @db.Uuid
  name           String
  status         CampaignStatus @default(DRAFT)
  mailboxId      String?        @db.Uuid

  objective      String?
  industryFocus  String?
  // Personalization brief handed to the model for every contact.
  personaBrief   String?  @db.Text
  offerBrief     String?  @db.Text
  toneGuidelines String?  @db.Text
  bannedPhrases  String[] @default([])

  // Sending window. Timezone falls back to the client's.
  timezone      String?
  sendDays      Int[]   @default([1, 2, 3, 4, 5])
  sendStartHour Int     @default(8)
  sendEndHour   Int     @default(16)
  dailyCap      Int     @default(30)

  approvalMode          ApprovalMode @default(REVIEW_ALL)
  autoApproveThreshold  Float        @default(0.92)
  approvedClaimTypes    ClaimType[]  @default([])
  maxContactsPerAccount Int          @default(1)
  /// Put engaged contacts into the call queue.
  callFollowUp          Boolean      @default(true)

  /**
   * Whether contextual (unpersonalized) drafts may be generated at all.
   */
  allowContextual    Boolean @default(true)
  /**
   * Hard ceiling on contextual sends per day, separate from the overall cap.
   */
  contextualDailyCap Int     @default(10)

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  icp          IdealCustomerProfile? @relation(fields: [icpId], references: [id], onDelete: SetNull)
  offer        Offer?                @relation(fields: [offerId], references: [id], onDelete: SetNull)
  playbook     Playbook?             @relation(fields: [playbookId], references: [id], onDelete: SetNull)
  mailbox      Mailbox?              @relation(fields: [mailboxId], references: [id], onDelete: SetNull)
  steps        CampaignStep[]
  enrollments  CampaignEnrollment[]
  messages     Message[]
  calls        Call[]
  callTasks    CallTask[]
  meetings     Meeting[]
  usageRecords UsageRecord[]

  @@index([organizationId, status])
  @@index([clientId, status])
}

model CampaignStep {
  id           String  @id @default(uuid()) @db.Uuid
  campaignId   String  @db.Uuid
  order        Int
  // Delay measured from the previous step's send, in hours. Step 0 = 0.
  delayHours   Int     @default(0)
  purpose      String // "opener" | "follow-up" | "new-angle" | "breakup"
  instructions String  @db.Text // fed to the personalization engine
  stopOnReply  Boolean @default(true)

  campaign Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([campaignId, order])
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  PAUSED
  REPLIED
  BOUNCED
  OPTED_OUT
  COMPLETED
  REMOVED
}

/**
 * One contact moving through one campaign's sequence.
 */
model CampaignEnrollment {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  campaignId     String  @db.Uuid
  accountId      String  @db.Uuid
  contactId      String? @db.Uuid

  status       EnrollmentStatus @default(PENDING)
  currentStep  Int              @default(0)
  nextActionAt DateTime?
  exitReason   String?
  enrolledAt   DateTime         @default(now())
  completedAt  DateTime?

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  account  Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact  Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
  @@index([organizationId, status, nextActionAt])
  @@index([accountId])
}

enum MessageStatus {
  GENERATING
  DRAFT // awaiting human review
  NEEDS_EDIT
  APPROVED
  SCHEDULED
  SENDING
  SENT
  DELIVERED
  OPENED
  CLICKED
  REPLIED
  BOUNCED
  COMPLAINED
  FAILED
  CANCELLED
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

/**
 * How much the draft actually knows about the recipient.
 * VERIFIED   — every specific claim traces to verified evidence.
 * CONTEXTUAL — nothing usable was found; the draft speaks to the industry and
 * the sender's own approved proof points only.
 * NONE       — no personalization at all. Blocked from sending by default.
 */
enum PersonalizationTier {
  VERIFIED
  CONTEXTUAL
  NONE
}

/**
 * Outcome of claim-level verification on a draft.
 */
enum VerificationStatus {
  VERIFIED
  PARTIALLY_VERIFIED
  REVIEW_REQUIRED
  UNSUPPORTED
  BLOCKED
}

enum ApprovalSource {
  HUMAN
  POLICY
}

enum ReplyClass {
  UNCLASSIFIED
  POSITIVE
  NEUTRAL
  NEGATIVE
  OUT_OF_OFFICE
  REFERRAL
  UNSUBSCRIBE
}

model Message {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  clientId       String  @db.Uuid
  accountId      String  @db.Uuid
  contactId      String? @db.Uuid
  campaignId     String? @db.Uuid
  campaignStepId String? @db.Uuid
  mailboxId      String? @db.Uuid

  direction MessageDirection @default(OUTBOUND)
  status    MessageStatus    @default(DRAFT)

  subject  String?
  bodyText String? @db.Text
  bodyHtml String? @db.Text

  // Personalization provenance — every draft records what it was built from.
  personalizationTier  PersonalizationTier @default(VERIFIED)
  /**
   * Why this fell back to CONTEXTUAL — shown in the review queue.
   */
  contextualReason     String?
  personalizationFacts Json? // [{factId, statement, sourceUrl, claim}]
  /**
   * Specific claims the linter could not tie to a ledger fact.
   */
  unverifiedClaims     Json?
  /**
   * Full lint output (blockers and warnings); gates approve/send.
   */
  lintFindings         Json?

  // Claim-level verification
  verificationStatus  VerificationStatus?
  verificationScore   Float?
  verificationSummary Json?
  verifiedAt          DateTime?

  model               String?
  promptVersion       String?
  generationCostCents Int?
  revisionOf          String? @db.Uuid
  editedByHuman       Boolean @default(false)

  approvedById   String?         @db.Uuid
  approvedAt     DateTime?
  approvalSource ApprovalSource?
  /// Snapshot of the policy that approved it: threshold, claim types, score.
  approvalPolicy Json?
  scheduledFor   DateTime?
  sentAt         DateTime?

  // Learning features, captured at send time
  stepOrder          Int?
  angle              String?
  ctaType            String?
  variantKey         String?
  signalIds          String[] @default([])
  accountScoreAtSend Int?
  contactScoreAtSend Int?

  // Inbound only
  replyClass        ReplyClass?
  replyClassifiedAt DateTime?

  providerMessageId String? @unique
  threadId          String?
  inReplyTo         String?

  openCount     Int       @default(0)
  clickCount    Int       @default(0)
  firstOpenedAt DateTime?
  bounceType    String?
  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  account      Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact      Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  campaign     Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  campaignStep CampaignStep?  @relation(fields: [campaignStepId], references: [id], onDelete: SetNull)
  mailbox      Mailbox?       @relation(fields: [mailboxId], references: [id], onDelete: SetNull)
  events       MessageEvent[]
  claims       MessageClaim[]

  @@index([organizationId, status])
  @@index([organizationId, status, personalizationTier])
  @@index([organizationId, scheduledFor])
  @@index([clientId, direction, sentAt])
  @@index([accountId, createdAt])
  @@index([contactId, createdAt])
  @@index([threadId])
}

model MessageEvent {
  id         String   @id @default(uuid()) @db.Uuid
  messageId  String   @db.Uuid
  type       String // delivered | opened | clicked | bounced | complained | replied
  payload    Json?
  occurredAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, occurredAt])
}

/**
 * Kinds of factual statement a draft can make about a prospect.
 */
enum ClaimType {
  JOB_TITLE
  COMPANY_LOCATION
  COMPANY_INDUSTRY
  COMPANY_SIZE
  PRODUCTS_SERVICES
  SERVICE_AREA
  HIRING
  EXPANSION
  NEW_LOCATION
  FUNDING
  NEW_CONTRACT
  NEW_PRODUCT
  TECHNOLOGY_USED
  LEADERSHIP_CHANGE
  CUSTOMER_OR_PARTNER
  AWARD_OR_CERTIFICATION
  REGULATORY_EVENT
  OTHER_FACT
}

enum ClaimKind {
  PROSPECT_FACT // about the recipient; needs evidence
  SENDER_PROOF // about the client; needs an approved proof point
  GENERAL_COPY // sales copy that asserts nothing checkable
}

enum ClaimStatus {
  SUPPORTED
  PARTIALLY_SUPPORTED
  UNSUPPORTED
  CONTRADICTED
  STALE
  NOT_REQUIRED
}

/**
 * One checkable statement in a draft and the evidence behind it.
 */
model MessageClaim {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid
  messageId      String      @db.Uuid
  text           String      @db.Text
  kind           ClaimKind
  claimType      ClaimType?
  status         ClaimStatus
  supportScore   Float       @default(0)
  /// Whether claimType was in the campaign's approved list at verification.
  approvedType   Boolean     @default(false)
  factId         String?
  signalId       String?     @db.Uuid
  proofPointId   String?     @db.Uuid
  sourceUrl      String?
  sourceQuote    String?     @db.Text
  evidenceDate   DateTime?
  freshnessDays  Int?
  reason         String?
  createdAt      DateTime    @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  signal       Signal?      @relation(fields: [signalId], references: [id], onDelete: SetNull)

  @@index([messageId])
  @@index([organizationId, claimType, status])
}

// ---------------------------------------------------------------------------
// Compliance
// ---------------------------------------------------------------------------

enum SuppressionScope {
  EMAIL
  DOMAIN
  PHONE
}

enum SuppressionChannel {
  ALL
  EMAIL
  PHONE
}

enum SuppressionReason {
  UNSUBSCRIBE
  MANUAL
  HARD_BOUNCE
  SPAM_COMPLAINT
  DO_NOT_CONTACT
  COMPETITOR
  EXISTING_CLIENT
  DO_NOT_CALL
}

enum SuppressionSource {
  UNSUBSCRIBE_LINK
  ONE_CLICK
  EMAIL_REPLY
  BOUNCE_WEBHOOK
  COMPLAINT_WEBHOOK
  CALL_OUTCOME
  MANUAL
  IMPORT
  SYSTEM
}

/**
 * Who not to contact, on which channel. clientId = null applies to every
 * client in the workspace (the default for opt-outs, bounces and complaints);
 * a client-scoped entry only blocks that client's outreach (e.g. their
 * existing customers).
 */
model Suppression {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @db.Uuid
  clientId       String?            @db.Uuid
  scope          SuppressionScope   @default(EMAIL)
  channel        SuppressionChannel @default(ALL)
  value          String // lowercased email, bare domain, or E.164-ish digits
  reason         SuppressionReason
  source         SuppressionSource  @default(MANUAL)
  note           String?
  contactId      String?            @db.Uuid
  campaignId     String?            @db.Uuid
  createdById    String?            @db.Uuid
  createdAt      DateTime           @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([organizationId, scope, value])
  @@index([value])
}

// Signed, single-use-per-recipient opt-out links (CAN-SPAM / CASL / GDPR).
model UnsubscribeToken {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  email          String
  token          String    @unique
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([organizationId, email])
}

// ---------------------------------------------------------------------------
// Activity, calls, meetings
// ---------------------------------------------------------------------------

enum ActivityType {
  NOTE
  CALL
  EMAIL_SENT
  EMAIL_RECEIVED
  MEETING
  STATUS_CHANGE
  TASK_COMPLETED
  PROPOSAL_SENT
  PROPOSAL_VIEWED
  RESEARCH_COMPLETED
  SYSTEM
  SIGNAL_DETECTED
  ENRICHMENT
  SUPPRESSION
  SCORE_OVERRIDE
}

model Activity {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  clientId       String       @db.Uuid
  accountId      String       @db.Uuid
  contactId      String?      @db.Uuid
  campaignId     String?      @db.Uuid
  userId         String?      @db.Uuid
  type           ActivityType
  title          String
  body           String?      @db.Text
  metadata       Json?
  occurredAt     DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([accountId, occurredAt(sort: Desc)])
  @@index([contactId, occurredAt(sort: Desc)])
  @@index([organizationId, type, occurredAt])
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

model Task {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @db.Uuid
  accountId      String?    @db.Uuid
  assigneeId     String?    @db.Uuid
  title          String
  description    String?    @db.Text
  status         TaskStatus @default(OPEN)
  priority       Int        @default(2) // 1 high, 2 normal, 3 low
  dueAt          DateTime?
  completedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account      Account?     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  assignee     User?        @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, dueAt])
}

enum CallDirection {
  OUTBOUND
  INBOUND
}

enum CallOutcome {
  NO_ANSWER
  VOICEMAIL
  CONNECTED
  NOT_INTERESTED
  CALL_BACK
  WRONG_PERSON
  WRONG_NUMBER
  REFERRED
  INTERESTED
  QUALIFIED
  MEETING_BOOKED
  DO_NOT_CALL
}

enum ObjectionType {
  TOO_EXPENSIVE
  ALREADY_HAVE_PROVIDER
  BAD_TIMING
  NO_NEED
  SEND_INFORMATION
  NOT_DECISION_MAKER
  OTHER
}

/**
 * One dial and what happened. Snapshots of the queue priority and reasons at
 * the moment of the call are kept so the ranking can later be judged against
 * outcomes.
 */
model Call {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  clientId       String        @db.Uuid
  accountId      String        @db.Uuid
  contactId      String?       @db.Uuid
  campaignId     String?       @db.Uuid
  callTaskId     String?       @db.Uuid
  callerId       String?       @db.Uuid
  direction      CallDirection @default(OUTBOUND)
  phoneNumber    String?

  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  durationSeconds Int?

  outcome       CallOutcome
  objections    ObjectionType[] @default([])
  objectionNote String?
  notes         String?         @db.Text
  callbackAt    DateTime?
  /// { name, title, email, phone } when the outcome is REFERRED.
  referredTo    Json?

  provider       String  @default("manual")
  providerCallId String?
  recordingUrl   String?

  queuePriorityAtCall Int?
  queueReasonsAtCall  Json?
  accountScoreAtCall  Int?
  contactScoreAtCall  Int?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  campaign     Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  caller       User?        @relation("Caller", fields: [callerId], references: [id], onDelete: SetNull)
  meeting      Meeting?

  @@index([organizationId, clientId, startedAt])
  @@index([contactId, startedAt])
  @@index([callerId, startedAt])
}

enum CallTaskStatus {
  OPEN
  SNOOZED
  COMPLETED
  CANCELLED
}

enum CallTaskCategory {
  CALLBACK_DUE
  REPLIED
  ENGAGED
  SIGNAL
  HIGH_FIT
  MANUAL
}

/**
 * A contact's place in the call queue. One row per contact; the history of
 * attempts lives in Call. Priority and reasons are recomputed by
 * services/call-queue whenever engagement, signals or outcomes change.
 */
model CallTask {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @db.Uuid
  clientId        String           @db.Uuid
  accountId       String           @db.Uuid
  contactId       String           @unique @db.Uuid
  campaignId      String?          @db.Uuid
  assigneeId      String?          @db.Uuid
  status          CallTaskStatus   @default(OPEN)
  category        CallTaskCategory
  priority        Int              @default(0)
  /// [{ code, label, detail, points }] — "why call now".
  reasons         Json
  dueAt           DateTime?
  snoozedUntil    DateTime?
  attempts        Int              @default(0)
  lastAttemptAt   DateTime?
  lastOutcome     CallOutcome?
  completedAt     DateTime?
  completedReason String?
  computedAt      DateTime         @default(now())
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  campaign     Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  assignee     User?        @relation("CallTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([organizationId, clientId, status, priority(sort: Desc)])
  @@index([assigneeId, status])
}

enum MeetingStatus {
  BOOKED
  CONFIRMED
  RESCHEDULED
  ATTENDED
  NO_SHOW
  CANCELLED
}

enum MeetingOutcome {
  PENDING
  QUALIFIED_OPPORTUNITY
  NOT_QUALIFIED
  WON
  LOST
}

enum MeetingSource {
  CALL
  EMAIL_REPLY
  CALENDAR_LINK
  INBOUND
  MANUAL
}

model Meeting {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  clientId       String  @db.Uuid
  accountId      String  @db.Uuid
  contactId      String? @db.Uuid
  campaignId     String? @db.Uuid
  callId         String? @unique @db.Uuid
  bookedById     String? @db.Uuid

  title       String
  startsAt    DateTime
  endsAt      DateTime
  timezone    String?
  location    String?
  meetingUrl  String?
  externalRef String? // calendar event id

  source  MeetingSource  @default(MANUAL)
  status  MeetingStatus  @default(BOOKED)
  outcome MeetingOutcome @default(PENDING)

  /// Shown to the client: why this prospect was qualified.
  qualificationNotes  String?   @db.Text
  /// Internal only.
  notes               String?   @db.Text
  estimatedValueCents Int?
  actualValueCents    Int?
  currency            String    @default("CAD")
  outcomeRecordedAt   DateTime?
  cancelledReason     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  campaign     Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  call         Call?        @relation(fields: [callId], references: [id], onDelete: SetNull)
  bookedBy     User?        @relation("MeetingBooker", fields: [bookedById], references: [id], onDelete: SetNull)

  @@index([organizationId, startsAt])
  @@index([clientId, startsAt])
}

// ---------------------------------------------------------------------------
// Proposals and prospect microsites (legacy agency tooling)
// ---------------------------------------------------------------------------

enum ProposalStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  DECLINED
  EXPIRED
}

model Proposal {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  accountId      String         @db.Uuid
  number         String // ORG-2026-0042
  title          String
  status         ProposalStatus @default(DRAFT)

  scope                 Json // [{phase, deliverables[], weeks}]
  lineItems             Json // [{label, qty, unitCents, recurring}]
  subtotalCents         Int    @default(0)
  taxCents              Int    @default(0)
  totalCents            Int    @default(0)
  recurringMonthlyCents Int    @default(0)
  currency              String @default("CAD")

  timeline   Json?
  roiSummary Json?
  diagram    Json?
  terms      String? @db.Text

  pdfUrl        String?
  shareToken    String    @unique
  viewCount     Int       @default(0)
  firstViewedAt DateTime?
  expiresAt     DateTime?
  acceptedAt    DateTime?
  signatureName String?
  signatureIp   String?

  /// The reviewed opportunity this proposal is for, when it came from one.
  opportunityId      String?   @db.Uuid
  /// Internal sign-off before it can be sent or accepted.
  approvedAt         DateTime?
  approvedById       String?   @db.Uuid
  /// How the customer authorised it when not through the share link (e.g. "signed SOW received").
  acceptanceEvidence String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([organizationId, number])
  @@index([organizationId, status])
}

model PortfolioSite {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  accountId      String  @db.Uuid
  templateId     String? @db.Uuid

  subdomain       String  @unique // acme-dental -> acme-dental.demos.yourdomain.com
  customDomain    String? @unique
  headline        String
  subheadline     String?
  logoUrl         String?
  /**
   * Using a prospect's logo without asking is a trademark problem and a bad
   * first impression. A site can only render a logo when consent is recorded.
   */
  logoConsent     Boolean @default(false)
  logoConsentNote String?
  accentColor     String  @default("#4F46E5")
  content         Json // hydrated template spec with account-specific copy
  showProposal    Boolean @default(true)
  showScheduler   Boolean @default(true)
  schedulerUrl    String?

  isPublished  Boolean   @default(false)
  publishedAt  DateTime?
  expiresAt    DateTime?
  passwordHash String?

  viewCount      Int       @default(0)
  uniqueVisitors Int       @default(0)
  firstViewedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account      Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  template     SolutionTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  views        PortfolioView[]

  @@index([organizationId])
}

model PortfolioView {
  id          String   @id @default(uuid()) @db.Uuid
  siteId      String   @db.Uuid
  visitorHash String // salted hash of IP+UA; no raw PII stored
  referrer    String?
  path        String?
  durationMs  Int?
  viewedAt    DateTime @default(now())

  site PortfolioSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, viewedAt])
}

// ---------------------------------------------------------------------------
// Connectors, provenance, jobs, cost
// ---------------------------------------------------------------------------

enum ProviderRecordStatus {
  SUCCESS
  NOT_FOUND
  ERROR
}

/**
 * Every request to an external data provider and what came back. Doubles as
 * the cache that stops Relay paying twice for the same lookup.
 */
model ProviderRecord {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @db.Uuid
  clientId       String?              @db.Uuid
  provider       String
  /// company.enrich | contact.search | email.find | email.verify | phone.find | website.crawl
  operation      String
  /// Normalized key the request was made for: a domain, an email, a name@domain.
  lookupKey      String
  externalId     String?
  status         ProviderRecordStatus
  request        Json?
  response       Json?
  normalized     Json?
  confidence     Float?
  costMillicents Int                  @default(0)
  error          String?
  accountId      String?              @db.Uuid
  contactId      String?              @db.Uuid
  requestedAt    DateTime             @default(now())
  refreshedAt    DateTime             @default(now())
  expiresAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, provider, operation, lookupKey, requestedAt(sort: Desc)])
}

/**
 * Where one field's current value came from. Superseded values are kept.
 */
model DataProvenance {
  id               String         @id @default(uuid()) @db.Uuid
  organizationId   String         @db.Uuid
  accountId        String?        @db.Uuid
  contactId        String?        @db.Uuid
  field            String
  value            String?
  source           DataSource
  provider         String?
  providerRecordId String?        @db.Uuid
  sourceUrl        String?
  status           EvidenceStatus @default(UNVERIFIED)
  confidence       Float?
  retrievedAt      DateTime       @default(now())
  /// Some sources (e.g. Google Places) may only be stored for a limited
  /// time. After this the value is purged unless another source confirms it.
  retentionUntil   DateTime?
  isCurrent        Boolean        @default(true)
  createdById      String?        @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account      Account?     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([accountId, field])
  @@index([contactId, field])
  @@index([retentionUntil])
}

/**
 * Per-workspace enablement and order of a provider within its capability.
 */
model ConnectorSetting {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  provider       String
  enabled        Boolean   @default(true)
  /// Lower runs first in a fallback chain.
  priority       Int       @default(100)
  settings       Json?
  lastCheckedAt  DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
}

enum JobType {
  ACCOUNT_ENRICHMENT
  CONTACT_ENRICHMENT
  RESEARCH
  VERIFICATION
  CAMPAIGN_SCHEDULING
  ANALYTICS
  PROVIDER_SYNC
  CALL_QUEUE_REFRESH
  RESCORE
  IMPORT
  DISCOVERY_RUN
  RETENTION_SWEEP
  MAINTENANCE
  SCREENING
  DEEP_RESEARCH
  OPPORTUNITY_ASSESSMENT
  RECORD_REFRESH
  DEMO_BUILD
  WORKFLOW_EXECUTION
  BILLING_SYNC
  /// Synthetic load for queue tests; only acts on synthetic clients.
  SYNTHETIC_TASK
}

/**
 * Generic background job, claimed by the worker with SKIP LOCKED.
 */
model Job {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String?   @db.Uuid
  clientId       String?   @db.Uuid
  type           JobType
  status         JobStatus @default(QUEUED)
  payload        Json?
  result         Json?
  error          String?
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3)
  runAt          DateTime  @default(now())
  lockedAt       DateTime?
  lockedBy       String?
  startedAt      DateTime?
  finishedAt     DateTime?
  entityType     String?
  entityId       String?
  /// Prevents enqueueing the same pending work twice.
  dedupeKey      String?
  /// Logical queue (see server/queues/registry.ts): its own concurrency,
  /// rate limit, timeout and pause switch.
  queue          String    @default("default")
  /// Higher runs first within a queue.
  priority       Int       @default(0)
  /// Unique per queue for the job's lifetime: enqueueing the same key again
  /// returns the existing job instead of doing the work twice.
  idempotencyKey String?
  /// External provider the job depends on, for throttling and circuit breaking.
  provider       String?
  /// Why the job is waiting, when it is (provider paused, queue paused).
  waitingReason  String?
  /// Set when the job gives up for good (attempts used up, or not retryable).
  deadLetteredAt DateTime?
  /// EXHAUSTED, NOT_RETRYABLE or TIMEOUT.
  failureKind    String?
  durationMs     Int?
  createdById    String?   @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  attemptLog   JobAttempt[]

  @@unique([queue, idempotencyKey])
  @@index([status, runAt])
  @@index([queue, status, priority, runAt])
  @@index([organizationId, type, createdAt])
  @@index([dedupeKey])
  @@index([deadLetteredAt])
}

/// One execution of a job: who ran it, how long it took, how it ended.
model JobAttempt {
  id         String    @id @default(uuid()) @db.Uuid
  jobId      String    @db.Uuid
  attempt    Int
  workerId   String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  durationMs Int?
  /// SUCCEEDED, FAILED, CONTINUED, TIMED_OUT or ABANDONED (worker died).
  outcome    String?
  error      String?

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, attempt])
  @@index([startedAt])
}

/// Operator overrides for a queue's defaults (server/queues/registry.ts).
model QueueSetting {
  queue             String   @id
  paused            Boolean  @default(false)
  pausedReason      String?
  concurrency       Int?
  maxPerMinute      Int?
  perOrgConcurrency Int?
  timeoutMs         Int?
  maxAttempts       Int?
  retryBaseMs       Int?
  updatedById       String?  @db.Uuid
  updatedAt         DateTime @updatedAt
}

/// Request budget and circuit breaker for one external provider, shared by
/// every worker. A provider that keeps failing is paused on its own, without
/// stopping work that doesn't need it.
model ProviderThrottle {
  provider            String    @id
  maxPerMinute        Int?
  windowStart         DateTime  @default(now())
  windowCount         Int       @default(0)
  consecutiveFailures Int       @default(0)
  failureThreshold    Int       @default(5)
  circuitOpenUntil    DateTime?
  /// Doubles each time the breaker re-opens after a failed trial request.
  cooldownMs          Int       @default(60000)
  lastError           String?
  lastFailureAt       DateTime?
  lastSuccessAt       DateTime?
  totalRequests       Int       @default(0)
  totalFailures       Int       @default(0)
  updatedAt           DateTime  @updatedAt
}

/// An immutable snapshot of one research run, so history survives refreshes.
/// Findings are split by how far they can be trusted.
model ResearchVersion {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @db.Uuid
  clientId           String   @db.Uuid
  accountId          String   @db.Uuid
  version            Int
  /// ANALYSIS (stage 3) or DEEP (stage 4).
  stage              String
  /// MANUAL, AUTO, SIGNAL, REFRESH or PROMOTION.
  trigger            String
  summary            String?  @db.Text
  /// Verified facts: supported by a quote located on an accessible source.
  facts              Json?
  /// AI hypotheses: reasonable inferences that need validation.
  hypotheses         Json?
  /// What cannot be established from outside the company.
  unknowns           Json?
  sources            Json?
  model              String?
  promptVersion      String?
  contentFingerprint String?
  /// Fields that changed since the previous version.
  changedFields      String[] @default([])
  costMillicents     Int      @default(0)
  createdAt          DateTime @default(now())

  @@unique([accountId, stage, version])
  @@index([organizationId, createdAt])
}

/// Per-workspace thresholds, caps, refresh schedule and budgets for the
/// research funnel. Budgets are enforced in the backend; null means no
/// category limit (the workspace AI budget still applies).
model PipelineSettings {
  organizationId         String   @id @db.Uuid
  screeningThreshold     Int      @default(55)
  deepThreshold          Int      @default(70)
  autoScreen             Boolean  @default(true)
  autoAnalyze            Boolean  @default(false)
  autoDeep               Boolean  @default(false)
  maxAnalysesPerDay      Int      @default(25)
  maxDeepPerDay          Int      @default(5)
  refreshDaysHot         Int      @default(14)
  refreshDaysWarm        Int      @default(30)
  refreshDaysExploratory Int      @default(60)
  refreshDaysLow         Int      @default(120)
  refreshDaysScreenedOut Int      @default(180)
  globalBudgetCents      Int?
  discoveryBudgetCents   Int?
  analysisBudgetCents    Int?
  deepBudgetCents        Int?
  enrichmentBudgetCents  Int?
  outreachBudgetCents    Int?
  /// Unit-cost assumptions for forecasts (services/pipeline/forecast.ts).
  costAssumptions        Json?
  updatedById            String?  @db.Uuid
  updatedAt              DateTime @updatedAt
}

/// Something an operator should know about: budget thresholds, stalled
/// workers, paused providers, dead letters. One open alert per key; repeats
/// bump its count instead of adding noise.
model SystemAlert {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String?   @db.Uuid
  /// info, warning or critical.
  severity         String
  kind             String
  title            String
  detail           String?   @db.Text
  dedupeKey        String
  occurrences      Int       @default(1)
  firstSeenAt      DateTime  @default(now())
  lastSeenAt       DateTime  @default(now())
  resolvedAt       DateTime?
  acknowledgedById String?   @db.Uuid
  acknowledgedAt   DateTime?

  @@unique([organizationId, dedupeKey])
  @@index([resolvedAt, lastSeenAt])
}

// ---------------------------------------------------------------------------
// Studio: customer applications assembled from versioned templates and
// tested modules. A customer is a Client; every row below carries clientId.
// ---------------------------------------------------------------------------

/// A reusable application template (built in when organizationId is null).
model AppTemplate {
  id                        String    @id @default(uuid()) @db.Uuid
  organizationId            String?   @db.Uuid
  slug                      String
  name                      String
  industry                  String
  description               String    @db.Text
  /// Use cases it covers, for solution matching.
  useCases                  String[]  @default([])
  /// Estimates used for proposals until real delivery data replaces them.
  buildHoursEstimate        Int?
  monthlyInfraCentsEstimate Int?
  recommendedSetupCents     Int?
  recommendedMonthlyCents   Int?
  knownLimitations          String[]  @default([])
  archivedAt                DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  versions     AppTemplateVersion[]
  applications ClientApplication[]

  @@unique([organizationId, slug])
  @@index([industry])
}

/// One immutable release of a template's manifest.
model AppTemplateVersion {
  id            String    @id @default(uuid()) @db.Uuid
  templateId    String    @db.Uuid
  /// Semantic version, e.g. 1.2.0. A major bump means existing apps need review to upgrade.
  version       String
  manifest      Json
  changelog     String?   @db.Text
  /// DRAFT, PUBLISHED or RETIRED.
  status        String    @default("DRAFT")
  /// When the template's own tests last passed for this version.
  testsPassedAt DateTime?
  createdById   String?   @db.Uuid
  createdAt     DateTime  @default(now())
  publishedAt   DateTime?

  template AppTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, version])
}

/// A customer's application: a template version plus that customer's configuration.
model ClientApplication {
  id                    String    @id @default(uuid()) @db.Uuid
  organizationId        String    @db.Uuid
  clientId              String    @db.Uuid
  templateId            String?   @db.Uuid
  templateVersionId     String?   @db.Uuid
  name                  String
  slug                  String
  /// DRAFT, TESTING, ACTIVE, PAUSED or ARCHIVED.
  status                String    @default("DRAFT")
  /// SHARED (multi-tenant runtime) or DEDICATED (own environment, priced separately).
  deployment            String    @default("SHARED")
  activeConfigVersionId String?   @db.Uuid
  maxExecutionsPerDay   Int       @default(500)
  maxConcurrent         Int       @default(2)
  /// Last scheduled run per workflow key, so a schedule fires once per slot.
  scheduleState         Json?
  /// SHA-256 of the token the customer's systems send to trigger workflows.
  webhookTokenHash      String?
  createdById           String?   @db.Uuid
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  archivedAt            DateTime?

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  template     AppTemplate?        @relation(fields: [templateId], references: [id], onDelete: SetNull)
  configs      AppConfigVersion[]
  executions   WorkflowExecution[]
  deployments  AppDeployment[]
  records      AppRecord[]

  @@unique([clientId, slug])
  @@index([organizationId, status])
}

/// One version of an application's configuration. Deployed versions are
/// never edited; a change is a new version, and rollback redeploys an old one.
model AppConfigVersion {
  id                String   @id @default(uuid()) @db.Uuid
  applicationId     String   @db.Uuid
  clientId          String   @db.Uuid
  version           Int
  /// The customer's settings on top of the template.
  overrides         Json
  /// Template manifest + overrides, as validated.
  manifest          Json
  templateVersionId String?  @db.Uuid
  /// DRAFT, VALID, INVALID, DEPLOYED or SUPERSEDED.
  status            String   @default("DRAFT")
  validationErrors  Json?
  notes             String?
  createdById       String?  @db.Uuid
  createdAt         DateTime @default(now())

  application ClientApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, version])
}

/// A deployment of one configuration version to an environment.
model AppDeployment {
  id                      String   @id @default(uuid()) @db.Uuid
  applicationId           String   @db.Uuid
  clientId                String   @db.Uuid
  configVersionId         String   @db.Uuid
  previousConfigVersionId String?  @db.Uuid
  /// SANDBOX or PRODUCTION.
  environment             String
  /// DEPLOY or ROLLBACK.
  kind                    String   @default("DEPLOY")
  status                  String   @default("SUCCEEDED")
  notes                   String?
  deployedById            String?  @db.Uuid
  createdAt               DateTime @default(now())

  application ClientApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
}

/// A customer's connection to one of their systems. Secrets are encrypted
/// at rest and never returned to a browser.
model IntegrationConnection {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @db.Uuid
  clientId        String    @db.Uuid
  /// rest_api, webhook, email_smtp, google_workspace, microsoft_365, database, file_import.
  provider        String
  label           String
  /// Non-secret settings: base URL, allowed hosts, scopes.
  config          Json      @default("{}")
  encryptedSecret String?
  /// CONNECTED, NEEDS_REAUTH, ERROR or DISCONNECTED.
  status          String    @default("CONNECTED")
  /// Test connections may be called by test runs; production ones never are.
  isSandbox       Boolean   @default(false)
  lastCheckedAt   DateTime?
  lastError       String?
  createdById     String?   @db.Uuid
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([clientId, provider])
}

/// One run of a workflow in a customer application.
model WorkflowExecution {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @db.Uuid
  clientId        String    @db.Uuid
  applicationId   String    @db.Uuid
  configVersionId String    @db.Uuid
  workflowKey     String
  /// MANUAL, SCHEDULE, WEBHOOK, RECORD or TEST.
  trigger         String
  /// Test runs use synthetic data and never call production connections.
  isTest          Boolean   @default(false)
  /// QUEUED, RUNNING, WAITING_APPROVAL, SUCCEEDED, FAILED or CANCELLED.
  status          String    @default("QUEUED")
  input           Json?
  output          Json?
  steps           Json?
  error           String?
  jobId           String?   @db.Uuid
  idempotencyKey  String?
  startedAt       DateTime?
  finishedAt      DateTime?
  durationMs      Int?
  createdAt       DateTime  @default(now())

  application ClientApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, idempotencyKey])
  @@index([applicationId, createdAt])
  @@index([clientId, status])
}

/// Business records an application keeps (claims, bookings, quotes…), in
/// the collections its manifest defines.
model AppRecord {
  id                   String   @id @default(uuid()) @db.Uuid
  clientId             String   @db.Uuid
  applicationId        String   @db.Uuid
  collection           String
  data                 Json
  isTest               Boolean  @default(false)
  createdByExecutionId String?  @db.Uuid
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  application ClientApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, collection, createdAt])
  @@index([clientId])
}

/// Liveness of worker processes (the long-running worker, cron ticks, page steps).
model WorkerHeartbeat {
  workerId      String   @id
  group         String
  startedAt     DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  jobsProcessed Int      @default(0)
  lastError     String?
  version       String?
}

enum UsageType {
  ENRICHMENT_REQUEST
  AI_RESEARCH
  AI_PERSONALIZATION
  AI_VERIFICATION
  AI_OTHER
  EMAIL_SENT
  EMAIL_VERIFICATION
  SMS
  PHONE_LOOKUP
  CALL_MINUTES
  EXTERNAL_DATA
  DISCOVERY_REQUEST
  AI_DEEP_RESEARCH
}

/**
 * One billable unit of work, attributed as precisely as it can be.
 */
model UsageRecord {
  id                   String    @id @default(uuid()) @db.Uuid
  organizationId       String    @db.Uuid
  clientId             String?   @db.Uuid
  campaignId           String?   @db.Uuid
  accountId            String?   @db.Uuid
  contactId            String?   @db.Uuid
  provider             String
  type                 UsageType
  quantity             Int       @default(1)
  /// Thousandths of a cent, so sub-cent email costs add up correctly.
  costMillicents       Int       @default(0)
  /// True when the cost is our configured estimate, not a figure from the provider.
  isEstimate           Boolean   @default(false)
  currency             String    @default("USD")
  aiRunId              String?   @db.Uuid
  providerRecordId     String?   @db.Uuid
  messageId            String?   @db.Uuid
  /// The background job that incurred the cost, when there was one.
  jobId                String?   @db.Uuid
  /// What was done, e.g. "places.searchText", "research.analyze".
  operation            String?
  durationMs           Int?
  /// The provider's billed figure, when it reports one (reconciled later).
  actualCostMillicents Int?
  metadata             Json?
  occurredAt           DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  campaign     Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([jobId])
  @@index([organizationId, occurredAt])
  @@index([clientId, occurredAt])
  @@index([provider, occurredAt])
}

// ---------------------------------------------------------------------------
// Admin, ops, observability
// ---------------------------------------------------------------------------

model AiRun {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  kind           String // research | personalize | verify | proposal | portfolio | classify
  entityId       String?   @db.Uuid
  provider       String // anthropic | openai
  model          String
  promptVersion  String
  status         JobStatus @default(QUEUED)
  tokensIn       Int       @default(0)
  tokensOut      Int       @default(0)
  costCents      Int       @default(0)
  latencyMs      Int?
  error          String?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, kind, createdAt])
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  userId         String?  @db.Uuid
  action         String // account.delete, message.approve, campaign.activate
  entityType     String
  entityId       String?
  before         Json?
  after          Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
}

// Idempotency ledger for every inbound webhook (Stripe, Resend, Clerk).
model WebhookEvent {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String?   @db.Uuid
  provider       String
  externalId     String
  type           String
  payload        Json
  processedAt    DateTime?
  error          String?
  receivedAt     DateTime  @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([processedAt])
}

model Invoice {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @db.Uuid
  accountId       String?   @db.Uuid
  number          String
  stripeInvoiceId String?   @unique
  amountCents     Int
  currency        String    @default("CAD")
  status          String // draft | open | paid | void | uncollectible
  dueAt           DateTime?
  paidAt          DateTime?
  createdAt       DateTime  @default(now())

  @@unique([organizationId, number])
  @@index([organizationId, status])
}

// ---------------------------------------------------------------------------
// Opportunity to application (brief 2, phase E)
// ---------------------------------------------------------------------------

/// A possible automation for one account, from deep research or entered by a
/// person. Nothing is demoed, proposed or built until a person qualifies it.
model Opportunity {
  id                  String    @id @default(uuid()) @db.Uuid
  organizationId      String    @db.Uuid
  clientId            String    @db.Uuid
  accountId           String    @db.Uuid
  title               String
  problem             String    @db.Text
  proposedAutomation  String    @db.Text
  /// DEEP_RESEARCH or MANUAL.
  source              String
  researchVersionId   String?   @db.Uuid
  evidenceFactIds     String[]  @default([])
  howToValidate       String?   @db.Text
  integrationBarriers String[]  @default([])
  /// The research's own confidence (0–1) when it came from research.
  confidence          Float?
  /// PROPOSED, QUALIFIED, REJECTED, DEMO, PROPOSAL, WON or LOST.
  status              String    @default("PROPOSED")
  reviewedById        String?   @db.Uuid
  reviewedAt          DateTime?
  reviewNote          String?
  templateId          String?   @db.Uuid
  templateVersionId   String?   @db.Uuid
  /// EXACT, CONFIGURATION, MODERATE, CUSTOM or NOT_FEASIBLE.
  reusability         String?
  /// Why: matched terms, barriers, what has to be built.
  reusabilityReasons  Json?
  matchScore          Float?
  /// A person changed the match or the class; automatic matching leaves it alone.
  matchOverridden     Boolean   @default(false)
  estimatedBuildHours Int?
  fromScratchHours    Int?
  /// How the estimate was made (template estimate, calibration from finished projects).
  estimateBasis       Json?
  /// Inputs for the value estimate, each with its source.
  assessment          Json?
  /// Projected value: a scenario from the assessment, never a measured result.
  projection          Json?
  proposalId          String?   @db.Uuid
  customerClientId    String?   @db.Uuid
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account      Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  demos        OpportunityDemo[]
  projects     DeliveryProject[]

  @@unique([researchVersionId, title])
  @@index([organizationId, status])
  @@index([accountId])
}

/// A personalised demo: a sandbox application on the workspace's demo
/// client, filled with synthetic records. Never touches customer data.
model OpportunityDemo {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @db.Uuid
  opportunityId   String   @db.Uuid
  applicationId   String   @db.Uuid
  configVersionId String   @db.Uuid
  sampleRuns      Int      @default(0)
  createdById     String?  @db.Uuid
  createdAt       DateTime @default(now())

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId])
}

/// Delivery of an accepted proposal: estimate against actual.
model DeliveryProject {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String    @db.Uuid
  clientId           String    @db.Uuid
  opportunityId      String?   @db.Uuid
  proposalId         String?   @db.Uuid
  applicationId      String?   @db.Uuid
  templateId         String?   @db.Uuid
  name               String
  /// PLANNED, BUILDING, TESTING, LIVE or CLOSED.
  status             String    @default("PLANNED")
  reusability        String?
  estimatedHours     Int
  estimatedCostCents Int       @default(0)
  priceSetupCents    Int       @default(0)
  priceMonthlyCents  Int       @default(0)
  startedAt          DateTime?
  liveAt             DateTime?
  closedAt           DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  opportunity Opportunity?       @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  timeEntries ProjectTimeEntry[]

  @@index([organizationId, status])
  @@index([clientId])
  @@index([templateId, closedAt])
}

model ProjectTimeEntry {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  userId    String?  @db.Uuid
  /// discovery, build, configuration, testing, meetings, support.
  category  String
  minutes   Int
  note      String?
  workDate  DateTime @db.Date
  createdAt DateTime @default(now())

  project DeliveryProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, workDate])
}

// ---------------------------------------------------------------------------
// Customer billing (brief 2, phase F)
// ---------------------------------------------------------------------------

/// What a customer pays for their application: a setup fee, a monthly fee in
/// arrears, and production runs above what is included. Nothing is charged
/// until a billing admin authorises it, and live charges need an explicit
/// switch on top (CUSTOMER_BILLING_LIVE).
model CustomerSubscription {
  id                      String    @id @default(uuid()) @db.Uuid
  organizationId          String    @db.Uuid
  clientId                String    @db.Uuid
  applicationId           String?   @db.Uuid
  projectId               String?   @db.Uuid
  name                    String
  /// DRAFT, ACTIVE, PAST_DUE or CANCELLED.
  status                  String    @default("DRAFT")
  /// ledger (invoices kept in Relay, paid outside it) or stripe.
  provider                String    @default("ledger")
  currency                String    @default("CAD")
  setupFeeCents           Int       @default(0)
  monthlyCents            Int
  /// Production runs included each month; usage is billed only above this.
  includedRuns            Int       @default(0)
  /// Price per run above the included amount, in thousandths of a cent.
  overageMillicentsPerRun Int       @default(0)
  authorizedById          String?   @db.Uuid
  authorizedAt            DateTime?
  startedAt               DateTime?
  currentPeriodStart      DateTime?
  currentPeriodEnd        DateTime?
  cancelAtPeriodEnd       Boolean   @default(false)
  cancelledAt             DateTime?
  stripeCustomerId        String?
  stripeSubscriptionId    String?   @unique
  livemode                Boolean   @default(false)
  createdById             String?   @db.Uuid
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  usage        MeteredUsage[]
  invoices     CustomerInvoice[]

  @@index([organizationId, status])
  @@index([clientId])
  @@index([status, currentPeriodEnd])
}

/// Measured usage for one billing period, from the platform's own run records.
model MeteredUsage {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  clientId       String   @db.Uuid
  subscriptionId String   @db.Uuid
  /// workflow_runs: production runs that executed (succeeded or failed).
  metric         String
  periodStart    DateTime
  periodEnd      DateTime
  quantity       Int
  measuredAt     DateTime @default(now())

  subscription CustomerSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, metric, periodStart])
}

model CustomerInvoice {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @db.Uuid
  clientId        String    @db.Uuid
  subscriptionId  String    @db.Uuid
  number          String
  /// SETUP, PERIOD, FINAL (ledger) or STRIPE (mirrored from Stripe).
  kind            String
  periodStart     DateTime
  periodEnd       DateTime
  /// [{label, quantity, unitMillicents, amountCents, kind}]
  lines           Json
  subtotalCents   Int
  taxCents        Int       @default(0)
  totalCents      Int
  currency        String
  /// DRAFT, OPEN, PAID, VOID or UNCOLLECTIBLE.
  status          String    @default("OPEN")
  provider        String
  stripeInvoiceId String?   @unique
  /// Ledger invoices: subscription + kind + period, so a period is invoiced once.
  idempotencyKey  String?   @unique
  livemode        Boolean   @default(false)
  issuedAt        DateTime  @default(now())
  dueAt           DateTime?
  paidAt          DateTime?
  voidedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  subscription CustomerSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([organizationId, number])
  @@index([organizationId, issuedAt])
  @@index([clientId, issuedAt])
}
